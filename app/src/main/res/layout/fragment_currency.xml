<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="8dp"
    tools:context=".ui.currency.CurrencyFragment">

    <!-- Phần hiển thị tiền tệ (giữ nguyên không đổi) -->
    <TextView
        android:id="@+id/tvFromSymbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/black"
        android:textSize="34sp"
        app:layout_constraintBaseline_toBaselineOf="@id/etAmountFrom"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="¥" />
    <EditText
        android:id="@+id/etAmountFrom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:background="@android:color/transparent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="end"
        android:inputType="none"
        android:text="1"
        android:textColor="@color/black"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvFromSymbol"
        app:layout_constraintTop_toTopOf="parent" />
    <Spinner
        android:id="@+id/spinnerFrom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/form_label_text"
        app:layout_constraintStart_toStartOf="@id/etAmountFrom"
        app:layout_constraintTop_toBottomOf="@id/etAmountFrom" />
    <TextView
        android:id="@+id/tvToSymbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/black"
        android:textSize="34sp"
        app:layout_constraintBaseline_toBaselineOf="@id/etAmountTo"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="₫" />
    <EditText
        android:id="@+id/etAmountTo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="@android:color/transparent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="end"
        android:inputType="none"
        android:text="171"
        android:textColor="@color/black"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvToSymbol"
        app:layout_constraintTop_toBottomOf="@id/spinnerFrom" />
    <Spinner
        android:id="@+id/spinnerTo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/form_label_text"
        app:layout_constraintStart_toStartOf="@id/etAmountTo"
        app:layout_constraintTop_toBottomOf="@id/etAmountTo" />

    <!-- BÀN PHÍM SỐ - ĐÃ THAY ĐỔI TỪ GRIDLAYOUT SANG CONSTRAINTLAYOUT -->
    <!-- Hàng nút 1: 7, 8, 9 -->
    <Button
        android:id="@+id/button_seven"
        style="@style/CalculatorNumberButton"
        android:text="7"
        app:layout_constraintTop_toBottomOf="@id/spinnerTo"
        app:layout_constraintBottom_toTopOf="@id/button_four"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_eight"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/button_eight"
        style="@style/CalculatorNumberButton"
        android:text="8"
        app:layout_constraintTop_toTopOf="@id/button_seven"
        app:layout_constraintBottom_toBottomOf="@id/button_seven"
        app:layout_constraintStart_toEndOf="@id/button_seven"
        app:layout_constraintEnd_toStartOf="@+id/button_nine" />

    <Button
        android:id="@+id/button_nine"
        style="@style/CalculatorNumberButton"
        android:text="9"
        app:layout_constraintTop_toTopOf="@id/button_seven"
        app:layout_constraintBottom_toBottomOf="@id/button_seven"
        app:layout_constraintStart_toEndOf="@id/button_eight"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hàng nút 2: 4, 5, 6 -->
    <Button
        android:id="@+id/button_four"
        style="@style/CalculatorNumberButton"
        android:text="4"
        app:layout_constraintTop_toBottomOf="@id/button_seven"
        app:layout_constraintBottom_toTopOf="@id/button_one"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_five"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/button_five"
        style="@style/CalculatorNumberButton"
        android:text="5"
        app:layout_constraintTop_toTopOf="@id/button_four"
        app:layout_constraintBottom_toBottomOf="@id/button_four"
        app:layout_constraintStart_toEndOf="@id/button_four"
        app:layout_constraintEnd_toStartOf="@+id/button_six" />

    <Button
        android:id="@+id/button_six"
        style="@style/CalculatorNumberButton"
        android:text="6"
        app:layout_constraintTop_toTopOf="@id/button_four"
        app:layout_constraintBottom_toBottomOf="@id/button_four"
        app:layout_constraintStart_toEndOf="@id/button_five"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hàng nút 3: 1, 2, 3 -->
    <Button
        android:id="@+id/button_one"
        style="@style/CalculatorNumberButton"
        android:text="1"
        app:layout_constraintTop_toBottomOf="@id/button_four"
        app:layout_constraintBottom_toTopOf="@id/button_ce"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_two"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/button_two"
        style="@style/CalculatorNumberButton"
        android:text="2"
        app:layout_constraintTop_toTopOf="@id/button_one"
        app:layout_constraintBottom_toBottomOf="@id/button_one"
        app:layout_constraintStart_toEndOf="@id/button_one"
        app:layout_constraintEnd_toStartOf="@+id/button_three" />

    <Button
        android:id="@+id/button_three"
        style="@style/CalculatorNumberButton"
        android:text="3"
        app:layout_constraintTop_toTopOf="@id/button_one"
        app:layout_constraintBottom_toBottomOf="@id/button_one"
        app:layout_constraintStart_toEndOf="@id/button_two"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hàng nút 4: CE, 0, Backspace -->
    <Button
        android:id="@+id/button_ce"
        style="@style/CalculatorOperatorButton"
        android:text="CE"
        app:layout_constraintTop_toBottomOf="@id/button_one"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_zero"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/button_zero"
        style="@style/CalculatorNumberButton"
        android:text="0"
        app:layout_constraintTop_toTopOf="@id/button_ce"
        app:layout_constraintBottom_toBottomOf="@id/button_ce"
        app:layout_constraintStart_toEndOf="@id/button_ce"
        app:layout_constraintEnd_toStartOf="@+id/button_bs" />

    <Button
        android:id="@+id/button_bs"
        style="@style/CalculatorOperatorButton"
        android:text="⌫"
        app:layout_constraintTop_toTopOf="@id/button_ce"
        app:layout_constraintBottom_toBottomOf="@id/button_ce"
        app:layout_constraintStart_toEndOf="@id/button_zero"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>