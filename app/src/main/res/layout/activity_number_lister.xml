<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".NumberListerActivity">

    <EditText
        android:id="@+id/etNumberLimit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nhập số nguyên giới hạn"
        android:inputType="number"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- RadioButton được đặt riêng lẻ -->
    <RadioButton
        android:id="@+id/rbOdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số lẻ" />

    <RadioButton
        android:id="@+id/rbPrime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số nguyên tố" />

    <RadioButton
        android:id="@+id/rbPerfect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số hoàn hảo" />

    <RadioButton
        android:id="@+id/rbEven"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số chẵn" />

    <RadioButton
        android:id="@+id/rbSquare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số chính phương" />

    <RadioButton
        android:id="@+id/rbFibonacci"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số Fibonacci" />

    <!-- Flow sẽ tự động sắp xếp các RadioButton được tham chiếu thành một lưới -->
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flow_radio_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:constraint_referenced_ids="rbOdd,rbPrime,rbPerfect,rbEven,rbSquare,rbFibonacci"
        app:flow_horizontalStyle="spread_inside"
        app:flow_maxElementsWrap="2"
        app:flow_wrapMode="chain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etNumberLimit" />

    <TextView
        android:id="@+id/tvNoResults"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="Không có số nào thỏa mãn"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/flow_radio_buttons" />

    <ListView
        android:id="@+id/lvResults"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/flow_radio_buttons" />

</androidx.constraintlayout.widget.ConstraintLayout>