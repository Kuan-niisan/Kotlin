<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Calculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/action_bar_background</item>
        <item name="colorPrimaryVariant">@color/action_bar_background</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Style CƠ BẢN cho TẤT CẢ các nút máy tính -->
    <style name="CalculatorButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Style cho nút SỐ (kế thừa từ style cơ bản) -->
    <style name="CalculatorNumberButton" parent="CalculatorButton">
        <item name="backgroundTint">@color/calculator_number_button_background</item>
    </style>

    <!-- Style cho nút CHỨC NĂNG (kế thừa từ style cơ bản) -->
    <style name="CalculatorOperatorButton" parent="CalculatorButton">
        <item name="backgroundTint">@color/calculator_operator_button_background</item>
    </style>

</resources>